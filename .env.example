# Vision-language model used to verify and name each change (any OpenAI-compatible endpoint).
# Optional: without these the pipeline runs fully offline with CLIP labels (weaker).
WC_LLM_BASE_URL=https://api.openai.com/v1
WC_LLM_API_KEY=sk-...
WC_LLM_MODEL=gpt-4o
# OPENAI_BASE_URL / OPENAI_API_KEY / OPENAI_MODEL are also accepted.

# Optional: Hugging Face token (only needed if model downloads are rate-limited)
# HF_TOKEN=hf_...
